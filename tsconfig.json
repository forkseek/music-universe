{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-test/types/**/*.ts",
    ".next-test/dev/types/**/*.ts",
    ".next-baseline/types/**/*.ts",
    ".next-baseline/dev/types/**/*.ts",
    ".next-qq-integration/types/**/*.ts",
    ".next-qq-integration/dev/types/**/*.ts",
    ".next-deployverify/types/**/*.ts",
    ".next-deployverify/dev/types/**/*.ts",
    ".next-deployverify2/types/**/*.ts",
    ".next-deployverify2/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-test",
    "work"
  ]
}
