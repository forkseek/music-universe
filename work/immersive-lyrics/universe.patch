+/* The image is a visual reference, not a recoverable font/animation specification.
+   Local serif faces keep loading deterministic; warm dust and depth follow its hierarchy. */
+.lyric-constellation {
+  --lyric-safe-bottom: env(safe-area-inset-bottom, 0px);
+  position: fixed;
+  z-index: 9;
+  width: min(820px, calc(100vw - 64px));
+  pointer-events: none;
+  user-select: none;
+  text-align: center;
+  font-family: Georgia, 'Noto Serif SC', 'Songti SC', SimSun, serif;
+  font-weight: 400;
+  font-synthesis: none;
+  background: transparent;
+  perspective: 850px;
+  isolation: isolate;
+  container-type: inline-size;
+  transition: left .28s ease, top .32s ease;
+}
+.lyric-row {
+  position: relative;
+  margin: 0;
+  font-size: clamp(16px, 1.75vw, 25px);
+  line-height: 1.4;
+  letter-spacing: .065em;
+  color: #c2b8ad;
+  text-wrap: balance;
+  overflow-wrap: anywhere;
+  text-shadow: 0 2px 9px #010711b3;
+  transition: opacity .36s ease, transform .44s ease, color .36s ease;
+}
+.lyric-row span { display: block; }
+.lyric-row:not(.lyric-row-current) span { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
+.lyric-row-previous { opacity: .3; transform: rotateX(14deg) scale(.84); }
+.lyric-row-current { margin: 9px 0 11px; font-size: clamp(25px, 2.8vw, 40px); line-height: 1.35; letter-spacing: .055em; color: #f7dfbd; }
+@supports (font-size: 1cqw) { .lyric-row-current { font-size: clamp(25px, 4.9cqw, 40px); } }
+.lyric-row-current span {
+  background-image: radial-gradient(circle, #fff7dfb3 .55px, transparent .85px), linear-gradient(105deg, #d7b18b 30%, #fff9e7 49%, #e0b992 69%);
+  background-size: 5px 7px, 220% 100%;
+  background-position: 0 0, calc((1 - var(--lyric-progress, 0)) * 100%) 0;
+  background-clip: text;
+  -webkit-background-clip: text;
+  -webkit-text-fill-color: transparent;
+  text-shadow: 0 0 15px #e5b8792e, 0 2px 12px #010711b3;
+  filter: drop-shadow(0 0 3px #ffe2b51f);
+  animation: lyric-condense .6s cubic-bezier(.2, .7, .2, 1) both;
+}
+.lyric-row-next { opacity: .51; transform: rotateX(-10deg) scale(.91); }
+.lyric-row-distant { margin-top: 7px; opacity: .17; transform: rotateX(-17deg) scale(.76); }
+.lyric-dust { position: absolute; left: -40px; top: -40px; z-index: 1; pointer-events: none; }
+@keyframes lyric-condense { from { opacity: .3; filter: blur(2px); transform: translateY(5px) scale(.985); } to { opacity: 1; filter: blur(0); transform: translateY(0) scale(1); } }
+@media (max-width: 620px), (max-height: 560px) {
