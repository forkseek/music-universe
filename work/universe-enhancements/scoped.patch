+  for (let frame = 0; frame < 240; frame++) {
+    const target: CameraFollowTarget = { id: 'song', position: [Math.cos(frame / 300) * 8, Math.sin(frame / 300) * 8, 2], starPosition: [0, 0, 0] }
+    controller.update(1 / 60, view, true, false, 1 / 60, target)
