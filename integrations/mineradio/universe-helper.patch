diff --git a/src/lib/localMusicHelper.ts b/src/lib/localMusicHelper.ts
new file mode 100644
index 0000000..690a355
--- /dev/null
+++ b/src/lib/localMusicHelper.ts
@@ -0,0 +1,43 @@
+const origin = 'http://127.0.0.1:43891'
+const storageKey = 'music-universe:local-helper:v1'
+interface HelperConnection { token: string; mediaToken: string; expiresAt: number }
+let current: HelperConnection | null | undefined
+
+function valid(value: unknown): value is HelperConnection {
+  if (!value || typeof value !== 'object') return false
+  const v = value as Partial<HelperConnection>
+  return typeof v.token === 'string' && /^[A-Za-z0-9_-]{43}$/.test(v.token) && typeof v.mediaToken === 'string' && /^[A-Za-z0-9_-]{43}$/.test(v.mediaToken) && typeof v.expiresAt === 'number'
+}
+export function localMusicConnection() {
+  if (current === undefined) {
+    try { const stored: unknown = JSON.parse(sessionStorage.getItem(storageKey) || 'null'); current = valid(stored) ? stored : null }
+    catch { current = null }
+  }
+  return current
+}
+export function localMusicTarget(path: string) {
+  const connection = localMusicConnection()
+  return connection && /^\/api\/(music|qq)\//.test(path) ? { origin, ...connection } : null
+}
+export function localMusicMedia(path: string): string | undefined {
+  const connection = localMusicConnection()
+  if (!connection || !/^\/api\/(music\/(audio|album\/cover)|qq\/(audio|cover|avatar))(\?|$)/.test(path)) return
+  const url = new URL(path, origin); url.searchParams.set('helperMedia', connection.mediaToken)
+  return url.href
+}
+export async function connectLocalMusicHelper() {
+  const options: RequestInit & { targetAddressSpace: 'loopback' } = { method: 'POST', credentials: 'omit', cache: 'no-store', headers: { 'X-Music-World': '1' }, signal: AbortSignal.timeout(20000), targetAddressSpace: 'loopback' }
+  let response: Response
+  try { response = await fetch(origin + '/connect', options) }
+  catch { throw new Error('连接不到本机助手。请先启动助手，并在浏览器询问时允许访问本机网络，然后重试。') }
+  const result = await response.json().catch(() => null)
+  if (!response.ok || result?.service !== 'music-universe-helper' || result?.protocol !== 1 || !valid(result)) throw new Error('本机助手未完成连接，请稍后重试。')
+  current = { token: result.token, mediaToken: result.mediaToken, expiresAt: result.expiresAt }
+  try { sessionStorage.setItem(storageKey, JSON.stringify(current)) } catch { /* Memory-only connection is supported. */ }
+}
+export async function disconnectLocalMusicHelper() {
+  const previous = localMusicConnection()
+  current = null
+  try { sessionStorage.removeItem(storageKey) } catch { /* Storage is optional. */ }
+  if (previous) await fetch(origin + '/disconnect', { method: 'POST', credentials: 'omit', headers: { 'X-Music-World': '1', Authorization: `Bearer ${previous.token}` }, signal: AbortSignal.timeout(3000) }).catch(() => {})
+}
