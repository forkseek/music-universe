# Replace the domain with your owned, DNS-configured public hostname.
DOMAIN=music.example.com
RELEASE_TAG=candidate
# Generate once on the server. This template is for a NEW database.
# For an existing encrypted database, preserve its original key and migrate
# encryption deliberately; changing the key makes stored credentials unreadable.
MUSIC_CREDENTIAL_SECRET=REPLACE_WITH_RANDOM_SECRET
NEXT_PUBLIC_ENABLE_QQMUSIC=false
# Optional: your registered QQ Connect WEBSITE application, not another app's keys.
# Identity authorization does not grant QQ Music playback rights.
QQ_CONNECT_APP_ID=
QQ_CONNECT_APP_SECRET=
QQ_CONNECT_REDIRECT_URI=
