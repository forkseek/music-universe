# No credentials required for file imports or the curated Demo library.
# Enable QQ only inside an authorized Tencent LinkLink custom H5 panel after checking the official SDK and project permission.
NEXT_PUBLIC_ENABLE_QQMUSIC=false

# Optional destination of the separately running Album Solar System scene.
NEXT_PUBLIC_MUSIC_UNIVERSE_URL=http://127.0.0.1:5188/

# Optional destination of the Hybrid Music Universe room, opened from the hall.
NEXT_PUBLIC_MUSIC_UNIVERSE_ROOM_URL=http://127.0.0.1:5173/?from=hall

# Optional, local-only bridge to a separately running, authorized radiohand API.
# In this mode run Music World on a different local port such as 3002.
RADIOHAND_API_ORIGIN=

# Server only. Never prefix a model key with NEXT_PUBLIC_. Keep none until a compatible service is available.
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
# Base URL ends at /v1 for a configured OpenAI-compatible service.
AI_BASE_URL=

# Server only. SQLite is created and migrated automatically on first use.
# In production use an absolute path on a persistent, writable local disk.
DATABASE_PATH=./data/music-world.db
# Set to your exact public origin behind a reverse proxy, without trailing slash.
# Leave empty for local development or localhost production; inferred from the request Host.
APP_ORIGIN=

# Keep empty to block embedding. For an authorized H5 host only, set exact HTTPS
# parent origins separated by spaces. Wildcards and HTTP origins are rejected.
# Rebuild and restart after changing the parent origins.
APP_FRAME_ANCESTORS=
