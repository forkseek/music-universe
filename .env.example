# Release branch codex/render-neon uses PostgreSQL; master keeps local SQLite.
# Neon: choose Direct connection (Connection pooling OFF). Server-only password.
DATABASE_URL=
# Keep the same randomly generated secret across deployments (at least 32 characters).
# Render Blueprint generates it automatically; do not rotate casually or expose publicly.
MUSIC_CREDENTIAL_SECRET=

# No platform account required for file imports, local audio or the curated Demo metadata.
# Enable QQ only inside an authorized Tencent LinkLink custom H5 panel after checking the official SDK and project permission.
NEXT_PUBLIC_ENABLE_QQMUSIC=false

# Hall opens the same-origin #universe subpage. The standalone 5188 app remains usable.
# Optional absolute path to the music-universe source, used by npm run build:universe.
MUSIC_UNIVERSE_SOURCE=


# Optional, local-only bridge to a separately running, authorized radiohand API.
# In this mode run Music World on a different local port such as 3002.
RADIOHAND_API_ORIGIN=

# Own, registered QQ Connect website application. Keep App Key on the server.
# QQ identity authorization does not grant QQ Music listening/member rights.
QQ_CONNECT_APP_ID=
QQ_CONNECT_APP_SECRET=
QQ_CONNECT_REDIRECT_URI=
# Callback path: /api/qq/login/callback on the registered application domain.

# Official Electron login windows are for a server running on this computer.
# Disabled on Render. Netease's in-page QR does not need Electron.
MUSIC_DESKTOP_LOGIN=0
# Optional absolute integration path. scripts/start.mjs resolves it automatically.
MUSIC_INTEGRATION_ROOT=

# Server only. Never prefix a model key with NEXT_PUBLIC_. Keep none until a compatible service is available.
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
# Base URL ends at /v1 for a configured OpenAI-compatible service.
AI_BASE_URL=

# Set to your exact public origin behind a reverse proxy, without trailing slash.
# scripts/start.mjs automatically uses RENDER_EXTERNAL_URL on Render.
APP_ORIGIN=

# Keep empty to block embedding. For an authorized H5 host only, set exact HTTPS
# parent origins separated by spaces. Wildcards and HTTP origins are rejected.
# Rebuild and restart after changing the parent origins.
APP_FRAME_ANCESTORS=
